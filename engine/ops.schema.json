{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edit operations (KICKOFF.md decision 9)",
  "description": "A list of edit operations. engine/ops.py applies them. For constrained decoding, replace target's pattern with an enum of the IDs present in the input.",
  "type": "array",
  "items": {
    "oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "old", "new"],
       "properties": {"op": {"const": "SUBSTITUTE_WORDS"}, "target": {"$ref": "#/$defs/target"}, "old": {"$ref": "#/$defs/words"}, "to": {"$ref": "#/$defs/to"}, "new": {"type": "string", "pattern": "^[^\\n]*$"}, "every": {"$ref": "#/$defs/every"}, "last": {"$ref": "#/$defs/last"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "position", "anchor", "text"],
       "properties": {"op": {"const": "INSERT_WORDS"}, "target": {"$ref": "#/$defs/target"}, "position": {"enum": ["after", "before"]}, "anchor": {"$ref": "#/$defs/words"}, "text": {"$ref": "#/$defs/words"}, "every": {"$ref": "#/$defs/every"}, "last": {"$ref": "#/$defs/last"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "text"],
       "properties": {"op": {"const": "OMIT_WORDS"}, "target": {"$ref": "#/$defs/target"}, "text": {"$ref": "#/$defs/words"}, "to": {"$ref": "#/$defs/to"}, "every": {"$ref": "#/$defs/every"}, "last": {"$ref": "#/$defs/last"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "block"],
       "properties": {"op": {"const": "SUBSTITUTE_NODE"}, "target": {"$ref": "#/$defs/target"}, "block": {"$ref": "#/$defs/block"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "position", "block"],
       "properties": {"op": {"const": "INSERT_NODE"}, "target": {"$ref": "#/$defs/target"}, "position": {"enum": ["after", "before"]}, "block": {"$ref": "#/$defs/block"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "block"],
       "properties": {"op": {"const": "ADD_AT_END"}, "target": {"$ref": "#/$defs/target"}, "block": {"$ref": "#/$defs/block"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target"],
       "properties": {"op": {"const": "OMIT_NODE"}, "target": {"$ref": "#/$defs/target"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "target", "label"],
       "properties": {"op": {"const": "RENUMBER"}, "target": {"$ref": "#/$defs/target"}, "label": {"type": "string", "pattern": "^[0-9A-Za-z]+$"}}}
    ]
  },
  "$defs": {
    "target": {"type": "string", "pattern": "^(preamble|art\\.\\d+[A-Z]*|s\\.\\d+[A-Z]*|sch\\.\\d+)(/heading|(\\([0-9A-Za-z]+\\)|/(proviso|explanation|para)([2-9]|[1-9]\\d+)?)*)$", "description": "A file, then labels and unlabelled provisions (the second proviso is /proviso2, the first has no number); /heading only on a whole file"},
    "words": {"type": "string", "minLength": 1, "pattern": "^[^\\n]+$", "description": "Words within one line"},
    "last": {"type": "boolean", "description": "The last occurrence only: \"occurring at the end\""},
    "to": {"type": "string", "minLength": 1, "pattern": "^[^\\n]+$", "description": "The portion's last words: \"the portion beginning with 'old' and ending with 'to'\", within one line"},
    "every": {"type": "boolean", "description": "Every occurrence: \"at both the places\", \"wherever they occur\". Without it the words must occur once in the target"},
    "block": {"type": "string", "minLength": 1, "description": "The inserted provisions as the amending text gives them, one provision per line"}
  }
}
